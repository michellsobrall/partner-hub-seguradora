# ==============================================================================
# PARTNER HUB - VARIÁVEIS DE AMBIENTE (DOCKER COMPOSE & INTEGRAÇÕES REAIS)
# ==============================================================================

# 1. Banco de Dados (PostgreSQL 15)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=partnerhub_db
DB_USER=partnerhub_user
DB_PASSWORD=partnerhub_password

# 2. PGAdmin (Web GUI)
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@partnerhub.local
PGADMIN_PASSWORD=admin123

# 3. Segurança JWT (HMAC-SHA256)
JWT_SECRET=supersecretpartnerhubtoken2026musthaveatleast256bitskeyhere
JWT_EXPIRATION_MS=86400000

# 4. Integração Asaas API v3 (Pix / TED Automático)
# - Para Sandbox Real do Asaas: https://sandbox.asaas.com/api/v3
# - Para Produção do Asaas:     https://api.asaas.com/v3
# - Basta preencher ASAAS_API_KEY abaixo (ex: $aact_YTU5YTE0M2M2N2I4...) para ativar!
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=whsec_partnerhub_asaas_2026

# 5. Motor de E-mails Transacionais (SMTP ou SendGrid API)
# - Opção A (SendGrid API): Preencha SENDGRID_API_KEY (ex: SG.xxxxxx)
# - Opção B (SMTP Padrão):  Preencha MAIL_HOST, MAIL_PORT, MAIL_USERNAME e MAIL_PASSWORD
#   (Se ambos estiverem vazios, o sistema registra o e-mail completo em modo Outbox Sandbox no banco)
SENDGRID_API_KEY=
MAIL_HOST=cloud21.mailgrid.net.br
MAIL_PORT=587
MAIL_USERNAME=hermanosti@hermanosti.com.br
MAIL_PASSWORD=
MAIL_FROM=sender@forma.dev.br
NFSE_DEADLINE_DAY=5
