# ==========================================
# PARTNER HUB - BACKEND (SPRING BOOT)
# ==========================================

# Configuração da Aplicação
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Conexão PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=partnerhub_db
DB_USER=partnerhub_user
DB_PASSWORD=partnerhub_password

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# JPA / Hibernate
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true
FLYWAY_ENABLED=true

# Autenticação & Segurança (JWT)
JWT_SECRET=supersecretpartnerhubtoken2026musthaveatleast256bitskeyhere
JWT_EXPIRATION_MS=86400000

# Integração Asaas (Sprint 03)
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=sua_chave_de_teste_asaas_aqui
