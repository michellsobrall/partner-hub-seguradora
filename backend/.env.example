# ==========================================
# PARTNER HUB - BACKEND (SPRING BOOT)
# ==========================================

# Configuração da Aplicação
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Conexão PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=partnerhub_db
DB_USER=partnerhub_user
DB_PASSWORD=partnerhub_password

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# JPA / Hibernate
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true
FLYWAY_ENABLED=true

# Autenticação & Segurança (JWT)
JWT_SECRET=supersecretpartnerhubtoken2026musthaveatleast256bitskeyhere
JWT_EXPIRATION_MS=86400000

# Integração Asaas API v3 (Sprint 03 & Sprint 07)
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=whsec_partnerhub_asaas_2026

# Motor de E-mails Transacionais (SMTP / SendGrid - Sprint 07)
SENDGRID_API_KEY=
MAIL_HOST=cloud21.mailgrid.net.br
MAIL_PORT=587
MAIL_USERNAME=hermanosti@hermanosti.com.br
MAIL_PASSWORD=
MAIL_FROM=sender@forma.dev.br
NFSE_DEADLINE_DAY=5
