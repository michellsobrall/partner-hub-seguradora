# =======================================================
# PARTNER HUB - FRONTEND ENVIRONMENT CONFIGURATION
# =======================================================

# Porta local do Vite Dev Server
VITE_PORT=5173

# Caminho base da API (usa proxy do Vite em dev ou URL absoluta em prod)
VITE_API_BASE_URL=/api/v1

# Target para proxy do Vite em desenvolvimento
VITE_API_PROXY_TARGET=http://localhost:8080

# Nome do Ambiente exibido no Header
VITE_APP_ENV=development
