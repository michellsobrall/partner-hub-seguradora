# =======================================================
# PARTNER HUB - RPA ENVIRONMENT CONFIGURATION
# =======================================================

# URL base da API Backend Spring Boot para ingestão dos dados extraídos
PARTNERHUB_API_URL=http://localhost:8080/api/v1
PARTNERHUB_API_TOKEN=dev_rpa_token_placeholder

# Configurações do Sistema Legado (Portal da Operadora / Corretora)
LEGACY_PORTAL_URL=https://portal-legado.exemplo.com.br
LEGACY_USERNAME=usuario_automacao
LEGACY_PASSWORD=senha_segura

# Configurações do Playwright
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000
PLAYWRIGHT_SLOW_MO_MS=0

